/**
 * @fileoverview Firestore Security Rules for Transport Titan application.
 *
 * Core Philosophy:
 * This ruleset enforces a combination of ownership-based access for user data and
 * broad access to top-level collections representing core entities like drivers, vehicles,
 * customers, routes, and suppliers. Expenses are modeled as subcollections to drivers,
 * vehicles, and routes.
 *
 * Data Structure:
 * - /users/{userId}: Stores user-specific data. Access is restricted to the authenticated user.
 * - /drivers/{driverId}: Stores driver information.
 * - /vehicles/{vehicleId}: Stores vehicle information.
 * - /customers/{customerId}: Stores customer information.
 * - /routes/{routeId}: Stores route information.
 * - /suppliers/{supplierId}: Stores supplier information.
 * - /vehicles/{vehicleId}/expenses/{expenseId}: Expenses related to a vehicle.
 * - /routes/{routeId}/expenses/{expenseId}: Expenses related to a route.
 * - /drivers/{driverId}/expenses/{expenseId}: Expenses related to a driver.
 *
 * Key Security Decisions:
 * - User data is strictly controlled by the owning user.
 * - Top-level collections (drivers, vehicles, etc.) are broadly accessible.
 * - Subcollections for expenses inherit the authorization context of their parent documents.
 * - Denormalization of parent IDs within expense documents ensures authorization independence.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own user data.
     * @path /users/{userId}
     * @allow (get, create, update, delete, list) if request.auth.uid == userId
     * @deny (get, create, update, delete, list) if request.auth.uid != userId
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows anyone to read driver information. Anyone can create, update, and delete driver information.
     * @path /drivers/{driverId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to driver information.
     */
    match /drivers/{driverId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read vehicle information. Anyone can create, update, and delete vehicle information.
     * @path /vehicles/{vehicleId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to vehicle information.
     */
    match /vehicles/{vehicleId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read customer information. Anyone can create, update, and delete customer information.
     * @path /customers/{customerId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to customer information.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: true;
    }

    /**
     * @description Allows anyone to read route information. Anyone can create, update, and delete route information.
     * @path /routes/{routeId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to route information.
     */
    match /routes/{routeId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read supplier information. Anyone can create, update, and delete supplier information.
     * @path /suppliers/{supplierId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to supplier information.
     */
    match /suppliers/{supplierId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read expenses for a specific vehicle. Anyone can create, update, and delete expenses for a specific vehicle.
     * @path /vehicles/{vehicleId}/expenses/{expenseId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to vehicle expenses.
     */
    match /vehicles/{vehicleId}/expenses/{expenseId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read expenses for a specific route. Anyone can create, update, and delete expenses for a specific route.
     * @path /routes/{routeId}/expenses/{expenseId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to route expenses.
     */
    match /routes/{routeId}/expenses/{expenseId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Allows anyone to read expenses for a specific driver. Anyone can create, update, and delete expenses for a specific driver.
     * @path /drivers/{driverId}/expenses/{expenseId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if true
     * @principle Grants broad access to driver expenses.
     */
    match /drivers/{driverId}/expenses/{expenseId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}